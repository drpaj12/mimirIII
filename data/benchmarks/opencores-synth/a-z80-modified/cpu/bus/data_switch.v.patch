+output wire	[7:0] db_up_out;	// MODIFIED (mimir a-z80-modified): was inout
+output wire	[7:0] db_down_out;	// MODIFIED (mimir a-z80-modified): was inout
 
+assign	db_up_out = sw_up_en ? db_down_in : 8'b0;	// MODIFIED (mimir a-z80-modified): one-way path down to up, 0 when off (was bidirectional tri-state)
+assign	db_down_out = sw_down_en ? db_up_in : 8'b0;	// MODIFIED (mimir a-z80-modified): one-way path up to down, 0 when off (was bidirectional tri-state)
 
 endmodule

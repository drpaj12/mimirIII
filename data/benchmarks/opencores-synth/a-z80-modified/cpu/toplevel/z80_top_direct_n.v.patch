+    output wire D_oe,
+    output wire pins_oe	// MODIFIED (mimir a-z80-modified): chip data bus split into D_in/D_out/D_oe; pins_oe = enable of the A, nMREQ, nIORQ, nRD, nWR outputs (high-Z on the original chip)
 );
 
 //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
 // Include core A-Z80 level connecting all internal modules
 //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
 `include "core.vh"
+assign pins_oe = pin_control_oe;	// MODIFIED (mimir a-z80-modified): exported enable for the address and control output pins (replaces their z state)
 

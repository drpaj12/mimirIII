--- a/cpu/toplevel/z80_top_direct_n.v
+++ b/cpu/toplevel/z80_top_direct_n.v
@@ -1,3 +1,8 @@
+// MODIFIED (mimir a-z80-modified) FILE HEADER:
+//   This is the mimir variant a-z80-modified of the upstream A-Z80 core: the bidirectional/tri-state internal data buses are replaced by one-way signals and AND-OR muxes selected by the existing enables.
+//   The upstream project (OpenCores a-z80) is unchanged; this file is produced from it by a patch kept in the mimir repo.
+//   z80_top_direct_n: D is split into D_in/D_out/D_oe and the output enable of A/nMREQ/nIORQ/nRD/nWR is exported as pins_oe. Wrap them back to pins in a bench.
+
 //============================================================================
 // Z80 Top level using the direct module declaration
 //============================================================================
@@ -21,13 +26,17 @@
 
